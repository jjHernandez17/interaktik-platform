PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiktok_games
DATABASE_SSL=false
SESSION_SECRET=cambia-esta-clave-por-una-segura

# --- Conexion a TikTok Live (obligatoria para que "Conectar a live" funcione) ---
# tiktok-live-connector firma la conexion al WebSocket de TikTok a traves de
# Euler Stream (eulerstream.com). Sin esta key, comparte el limite gratuito de
# la comunidad (se agota facil con muchos usuarios). Cuenta gratis en
# eulerstream.com -> Dashboard -> API Keys -> Create Key.
EULERSTREAM_API_KEY=

# --- Pagos: Stripe ---
# Llave secreta de tu cuenta Stripe (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=
# Firma del webhook (dashboard.stripe.com -> Developers -> Webhooks -> tu endpoint)
STRIPE_WEBHOOK_SECRET=

# --- Pagos: MercadoPago ---
# Access token de tu cuenta MercadoPago (mercadopago.com/developers -> Tus integraciones)
MERCADOPAGO_ACCESS_TOKEN=
# Moneda en la que cobra tu cuenta MercadoPago (depende del pais de la cuenta)
MERCADOPAGO_CURRENCY=USD
# Clave secreta del webhook (mercadopago.com/developers -> Tu app -> Webhooks -> Clave secreta)
MERCADOPAGO_WEBHOOK_SECRET=

# --- Montos minimos permitidos por pasarela (en PESOS COP, no centavos) ---
# Usados para validar los precios que el admin le pone a los planes. Verifica
# estos numeros en el dashboard/docs de cada pasarela; son solo un default.
WOMPI_MIN_AMOUNT_COP=1500
MERCADOPAGO_MIN_AMOUNT_COP=1500

# --- Pagos: Wompi (Colombia) ---
# Dashboard de comercios -> Desarrolladores -> Llaves API
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Dashboard de comercios -> Mi cuenta -> Secretos para integracion tecnica
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Correo: verificacion de cuenta al registrarse ---
# Funciona con cualquier proveedor SMTP: Gmail (con "contrasena de aplicacion",
# no tu contrasena normal), Resend, SendGrid, Mailgun, etc.
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu-correo@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Direccion que aparece como remitente (si se deja vacio, usa SMTP_USER)
SMTP_FROM=
