:root {
  --bg: #080d1a;
  --panel: rgba(15, 23, 42, 0.9);
  --panel-strong: rgba(15, 23, 42, 0.96);
  --line: rgba(148, 163, 184, 0.18);
  --text: #e5eefc;
  --muted: #94a3b8;
  --primary: #8b5cf6;
  --accent: #06b6d4;
  --success: #22c55e;
  --danger: #ef4444;
}

* {
  box-sizing: border-box;
}

html,
body {
  min-height: 100%;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(139, 92, 246, 0.18), transparent 34%),
    radial-gradient(circle at top right, rgba(6, 182, 212, 0.14), transparent 30%),
    linear-gradient(180deg, #060912 0%, #0b1020 100%);
}

button,
input,
select {
  font: inherit;
}

.back-menu-btn {
  position: fixed;
  left: 20px;
  top: 20px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  border-radius: 12px;
  background: rgba(139, 92, 246, 0.14);
  border: 1px solid rgba(139, 92, 246, 0.3);
  color: var(--text);
  text-decoration: none;
  cursor: pointer;
  transition: transform 0.15s ease, filter 0.15s ease, background 0.15s ease;
  font-weight: 600;
  font-size: 0.92rem;
  z-index: 100;
  backdrop-filter: blur(10px);
}

.back-menu-btn:hover {
  background: rgba(139, 92, 246, 0.24);
  transform: translateX(-2px);
}

.back-menu-btn:active {
  transform: translateX(0);
}

.snake-shell {
  width: min(1440px, calc(100% - 32px));
  margin: 0 auto;
  padding: 88px 0 28px;
}

.snake-hero {
  display: block;
  margin-bottom: 20px;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.78rem;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  font-size: clamp(2rem, 4vw, 3.6rem);
  margin-bottom: 12px;
}

.subtitle {
  max-width: 68ch;
  color: var(--muted);
  line-height: 1.65;
  margin-bottom: 0;
}

.stat-card,
.board-card,
.panel-card {
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.82));
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: 0 18px 60px rgba(2, 6, 23, 0.3);
}

